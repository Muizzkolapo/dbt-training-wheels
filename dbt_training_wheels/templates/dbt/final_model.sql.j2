{#- Final Model Template -#}
{#- Variables: table_name, query_name, sql_logic, materialization, schema, tags, include_config_block, include_source_comment -#}
{% if include_config_block -%}
{% set config_parts = ["materialized='" ~ materialization ~ "'"] -%}
{% if schema -%}
{% set config_parts = config_parts + ["schema='" ~ schema ~ "'"] -%}
{% endif -%}
{#- Quote and join in one expression. A {% set %} inside a {% for %} does not survive
    the loop scope in Jinja2, so building this up in a loop silently emitted tags=[] -#}
{% if tags -%}
{% set config_parts = config_parts + ["tags=['" ~ tags|join("', '") ~ "']"] -%}
{% endif -%}
{{ '{{' }} config({{ config_parts|join(', ') }}) {{ '}}' }}

{% endif -%}
-- Final model: {{ table_name }}
{% if include_source_comment -%}
-- Source: {{ query_name }}
{% endif -%}
-- Generated by DBT Training Wheels Conversion Tool

{% if sql_logic -%}
{{ sql_logic }}
{%- else -%}
-- NOTE: SQL extraction not available for this table
-- Please copy the transformation logic from your original query

SELECT
  *
FROM {{ '{{' }} source('schema', 'table') {{ '}}' }}
{%- endif %}
